{
  "name": "vue3-migration-tool",
  "version": "1.1.3",
  "description": "AI-powered Vue 2 to Vue 3 migration tool with Vuetify 3 support",
  "type": "module",
  "keywords": [
    "vue",
    "vue3",
    "migration",
    "codemod",
    "vuetify",
    "ai",
    "automation"
  ],
  "author": "tefikrudari",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tefik-Rudari/migration-tool-vue2-vue3.git"
  },
  "bugs": {
    "url": "https://github.com/Tefik-Rudari/migration-tool-vue2-vue3/issues"
  },
  "homepage": "https://github.com/Tefik-Rudari/migration-tool-vue2-vue3#readme",
  "bin": {
    "vue3-migrate": "./dist/index.js"
  },
  "files": [
    "dist",
    "MIGRATION_RULES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
