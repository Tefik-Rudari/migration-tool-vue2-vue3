    "chalk": "^5.3.0",
    "commander": "^10.0.1",
    "dotenv": "^17.2.3",
    "execa": "^7.2.0",
    "globby": "13.2.2",
    "node-fetch": "^3.3.2",
    "ora": "^6.3.1",
    "prettier": "^3.3.3",
    "prompts": "^2.4.2",
    "recast": "^0.23.9",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@types/prompts": "^2.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
